PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/youtube_clone?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@yourtube.app

# Recommended for Render/live OTP delivery. This uses HTTPS instead of SMTP.
# Use RESEND_FROM=YourTube <onboarding@resend.dev> only to test the Resend
# account email; use a verified-domain sender before sending to other people.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=YourTube <onboarding@resend.dev>

# Gmail invoice delivery (use a Google App Password, never your normal password).
SMTP_SERVICE=gmail
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+10000000000

# Add one translation provider. Google Cloud Translation is recommended.
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translation_api_key
TRANSLATE_API_URL=https://your-translation-service.example/translate

OTP_DEBUG_MODE=false
NODE_ENV=production
